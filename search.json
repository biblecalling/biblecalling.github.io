---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "category": {{ post.categories.first | default: "Faith" | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "description": {{ post.description | default: "" | jsonify }},
    "excerpt": {{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 180 | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | truncate: 350 | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
